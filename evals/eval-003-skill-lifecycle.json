{
  "id": "eval-003",
  "name": "技能生命周期",
  "description": "Agent 创建、查看、修补技能的完整流程",
  "tags": ["skill", "lifecycle"],
  "setup": {
    "workspace_dir": "workspace",
    "skills_dir": "workspace/.blm/skills",
    "system_prompt": "你是 BLM Agent，可以管理技能"
  },
  "turns": [
    {
      "user": "创建一个名为 hello-world 的技能",
      "mock_llm": {
        "text": "让我创建这个技能",
        "tool_blocks": [
          {"id": "t1", "name": "skill_manage", "input": {
            "action": "create",
            "name": "hello-world",
            "description": "A greeting skill",
            "content": "# Hello World\n\n## Steps\n1. Greet the user\n2. Ask what they need"
          }}
        ]
      }
    },
    {
      "user_result": [
        {"type": "tool_result", "tool_use_id": "t1", "content": "Skill 'hello-world' created at workspace/.blm/skills/hello-world/SKILL.md"}
      ],
      "mock_llm": {
        "text": "技能 hello-world 已创建成功！",
        "tool_blocks": []
      }
    }
  ],
  "assertions": {
    "tools_called": ["skill_manage"],
    "min_turns": 1,
    "output_contains": ["创建", "hello-world"]
  }
}
